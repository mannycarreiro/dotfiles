eval "$(/opt/homebrew/bin/brew shellenv)"

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# =====================
#        zinit
# =====================
ZINIT_GITHUB_REPO=https://github.com/zdharma-continuum/zinit.git

# DIRECTORY WHERE zinit AND ITS PLUGINS
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"

# DOWNLOAD zinit
if [ ! -d "${ZINIT_HOME}" ]; then
    mkdir -p "$(dirname $ZINIT_HOME)"
    git clone "${ZINIT_GITHUB_REPO}" "${ZINIT_HOME}"
fi

# INSTALL/LOAD zinit
source "${ZINIT_HOME}/zinit.zsh"

# LOAD PowerLevel10k
zinit ice depth=1; zinit light romkatv/powerlevel10k

# =====================
#     ZSH PLUGINS
# =====================
zinit light zsh-users/zsh-syntax-highlighting
zinit light zsh-users/zsh-completions
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'  # ALLOW CASE SENSITIVE AUTO COMPLETION
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" # USE COLORS
zstyle ':completion:*' menu no                          # USE FZF TO PICK FROM AUTO COMPLETION
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab-complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'
autoload -U compinit && compinit #LOAD COMPLETIONS AT STARTUP
zinit light zsh-users/zsh-autosuggestions
zinit light Aloxaf/fzf-tab
zinit cdreplay -q

# LOAD PLUGINS FROM oh-my-zsh (OMZP) REPO
zinit snippet OMZP::git
zinit snippet OMZP::kubectl
zinit snippet OMZP::kubectx
zinit snippet OMZP::command-not-found
zinit snippet OMZP::sudo
zinit snippet OMZP::docker
zinit snippet OMZP::docker-compose
zinit snippet OMZP::chezmoi
zinit snippet OMZP::ansible





# =====================
# KEY BINDINGS
# =====================
#bindkey '^f' autosugest-accept # CONTROL + F
bindkey -e # EMACS MODE (ALSO USES CONTROL +F TO ACCEPT AUTO SUGGEST BUT ALSO BINDS MORE KEYS)
bindkey '^p' history-search-backward # ENSURE AUTO SUGGEST FILTERS BY THE FIRST WORD (PREVIOUS HIT)
bindkey '^n' history-search-forward  # ENSURE AUTO SUGGEST FILTERS BY THE FIRST WORD (NEXT HIT)

# ===========================
# HISTORY CONFIGURATION
# ===========================
HISTSIZE=6000
HISTFILE=~/.zsh_history
SAVEHIST=${HISTSIZE}
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# ===========================
# SHELL INTEGRATIONS
# ===========================
eval "$(fzf --zsh)"


# ===========================
# ALIASES
# ===========================
alias ls='ls --color'
alias ll='ls -ltra --color'
alias vim='nvim'
alias e='vim'
alias vi='vim'
alias c='clear'
alias cat='bat'
alias v='cat'

# ===========================
# ZOXIDE
# ===========================
eval "$(zoxide init --cmd cd zsh)"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ==== K8S ====
export KUBECONFIG=/Users/manny/develop/talos_k8s/sousaca-k8s/sousaca-k8s

kns() {
  local ns
  ns=$(kubectl get namespaces --no-headers -o custom-columns=':metadata.name' 2>/dev/null | \
    fzf \
      --preview 'kubectl get pods -n {} --no-headers 2>/dev/null | head -30 || echo "No pods"' \
      --preview-window=right:60% \
      --prompt='namespace> ')
  [ -n "$ns" ] && kubectl config set-context --current --namespace="$ns" && echo "Switched to namespace: $ns"
}

# ==== BITWARDEN ====
#export SSH_AUTH_SOCK=/Users/manny/.bitwarden-ssh-agent.sock

# ==== SOURCE ALL sshconfig.d ====
export DEVOPS_SILENT=1
for f in "$HOME/zshconfig.d/"*.sh; do
    [[ -f "$f" ]] && source "$f"
done

# -- Open cheat-sheet HTML file ---
alias aliashelp="open /Users/manny/zshconfig.d/devops_cheat-sheet.html"

# -- Open SSH Session Manager Page ---
alias sshmanager="open http://localhost:8822"

# --- HOMEBREW ---
export HOMEBREW_REQUIRE_TAP_TRUST=1

fssh() {
  local host tmpscript

  # Write preview script to temp file to avoid quoting issues with fzf -> sh -> awk chain
  tmpscript=$(mktemp /tmp/fssh_preview.XXXXXX) || return 1
  cat > "$tmpscript" << 'PREVIEW_EOF'
#!/bin/sh
h="$1"; shift
awk -v h="$h" '
  /^[[:space:]]*#/ { if (f) print; else c = c $0 "\n"; next }
  /^[[:space:]]*$/ { if (f) print; else c = ""; next }
  /^Host / {
    if ($2 == h) { f=1; printf "%s", c; print }
    else { f=0 }
    c = ""; next
  }
  f { print }
' "$@"
PREVIEW_EOF
  chmod +x "$tmpscript"

  host=$(awk '
    BEGIN { FS=" +" }
    /^Host [^*]/ {
      for (i=2; i<=NF; i++)
        print $i
    }
  ' /Users/manny/.ssh/config.d/* ~/.ssh/config 2>/dev/null | \
    sort -u | \
    fzf \
      --preview "$tmpscript {} /Users/manny/.ssh/config.d/* ~/.ssh/config" \
      --preview-window=right:50%)

  rm -f "$tmpscript"
  [ -n "$host" ] && ssh "$host"
}
# Ctrl+s for SSH fuzzy search
bindkey -s '^s' 'fssh\n'

# stty -ixon must run after _p9k_precmd (p10k resets terminal state in its precmd hook)
_stty_ixon_precmd() { stty -ixon 2>/dev/null }
precmd_functions+=(_stty_ixon_precmd)

